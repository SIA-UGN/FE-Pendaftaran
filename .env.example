# Copy this file to .env.local and adjust values for your environment.
#
# IMPORTANT:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - Keep secrets out of NEXT_PUBLIC_ variables.

# Base URL of the backend API (should include /api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Axios request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=10000

# Google reCAPTCHA site key used on the login page
# (Leave empty to disable only if the UI tolerates it)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY

# Server-side base URL used by server actions (backend base URL, without /api)
APP_URL=http://localhost:8000
